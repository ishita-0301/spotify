# Copy to .env and fill in. All optional — without these the app uses mocks.

# Spotify app credentials (https://developer.spotify.com/dashboard).
# Only the client-credentials flow is used (track search) — no user login,
# no Spotify Premium required.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional: Spotify OAuth login (authorization-code flow) so users can sign in
# with their Spotify account. Defaults to the client id/secret above; set a
# Redirect URI that exactly matches one registered on the Spotify dashboard.
# Leave blank to hide the "Log in with Spotify" button (app still runs offline).
# SPOTIFY_OAUTH_CLIENT_ID=
# SPOTIFY_OAUTH_CLIENT_SECRET=
# SPOTIFY_OAUTH_REDIRECT_URI=http://127.0.0.1:5000/auth/spotify/callback

# Gemini API key (https://aistudio.google.com/apikey) — free tier is fine.
GEMINI_API_KEY=

# auto = use a real provider when its credentials exist, else fall back to mock.
WMS_PROVIDERS=auto

# Secret used to sign the web login session cookie. The app has a dev default,
# but set your own (any long random string) for anything beyond local use.
WMS_SECRET_KEY=
