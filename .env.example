# Copy to .env and fill in. All optional — without these the app uses mocks.

# Spotify app credentials (https://developer.spotify.com/dashboard).
# Only the client-credentials flow is used (track search) — no user login,
# no Spotify Premium required.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Gemini API key (https://aistudio.google.com/apikey) — free tier is fine.
GEMINI_API_KEY=

# auto = use a real provider when its credentials exist, else fall back to mock.
WMS_PROVIDERS=auto
